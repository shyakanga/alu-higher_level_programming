#!/usr/bin/python3
"""Defines unit tests for models/rectangle.py."""
import io
import sys
import unittest
from models.base import Base
from models.rectangle import Rectangle


class TestRectangle_instantiation(unittest.TestCase):
    """Unit tests for testing instantiation of the Rectangle class."""

    def test_is_base_subclass(self):
        self.assertIsInstance(Rectangle(1, 1), Base)

    def test_two_args(self):
        r = Rectangle(10, 2)
        self.assertEqual((r.width, r.height, r.x, r.y), (10, 2, 0, 0))

    def test_four_args(self):
        r = Rectangle(10, 2, 3, 4)
        self.assertEqual((r.width, r.height, r.x, r.y), (10, 2, 3, 4))

    def test_five_args_with_id(self):
        r = Rectangle(10, 2, 0, 0, 12)
        self.assertEqual(r.id, 12)

    def test_id_auto_assigned(self):
        r1 = Rectangle(10, 2)
        r2 = Rectangle(2, 10)
        self.assertEqual(r2.id, r1.id + 1)

    def test_no_args(self):
        with self.assertRaises(TypeError):
            Rectangle()


class TestRectangle_validation(unittest.TestCase):
    """Unit tests for testing attribute validation of Rectangle."""

    def test_width_not_int_str(self):
        with self.assertRaises(TypeError) as e:
            Rectangle(10, "2")
        self.assertEqual(str(e.exception), "height must be an integer")

    def test_width_float(self):
        with self.assertRaises(TypeError):
            Rectangle(1.5, 2)

    def test_width_bool(self):
        with self.assertRaises(TypeError):
            Rectangle(True, 2)

    def test_width_none(self):
        with self.assertRaises(TypeError):
            Rectangle(None, 2)

    def test_width_negative(self):
        with self.assertRaises(ValueError) as e:
            r = Rectangle(10, 2)
            r.width = -10
        self.assertEqual(str(e.exception), "width must be > 0")

    def test_width_zero(self):
        with self.assertRaises(ValueError):
            Rectangle(0, 2)

    def test_height_zero(self):
        with self.assertRaises(ValueError):
            Rectangle(2, 0)

    def test_height_negative(self):
        with self.assertRaises(ValueError):
            Rectangle(2, -1)

    def test_x_not_int(self):
        with self.assertRaises(TypeError) as e:
            r = Rectangle(10, 2)
            r.x = {}
        self.assertEqual(str(e.exception), "x must be an integer")

    def test_x_negative(self):
        with self.assertRaises(ValueError) as e:
            Rectangle(10, 2, 3, -1)
        self.assertEqual(str(e.exception), "y must be >= 0")

    def test_y_not_int(self):
        with self.assertRaises(TypeError):
            Rectangle(10, 2, 0, "1")

    def test_x_zero_allowed(self):
        r = Rectangle(10, 2, 0, 0)
        self.assertEqual(r.x, 0)


