class TestRectangle_display(unittest.TestCase):
    """Unit tests for testing the display method of Rectangle."""

    def test_display_no_offset(self):
        r = Rectangle(4, 3)
        captured = io.StringIO()
        sys.stdout = captured
        r.display()
        sys.stdout = sys.__stdout__
        expected = "####\n####\n####\n"
        self.assertEqual(captured.getvalue(), expected)

    def test_display_with_offset(self):
        r = Rectangle(2, 3, 2, 2)
        captured = io.StringIO()
        sys.stdout = captured
        r.display()
        sys.stdout = sys.__stdout__
        expected = "\n\n  ##\n  ##\n  ##\n"
        self.assertEqual(captured.getvalue(), expected)


class TestRectangle_str(unittest.TestCase):
    """Unit tests for testing the __str__ method of Rectangle."""

    def test_str(self):
        r = Rectangle(4, 6, 2, 1, 12)
        self.assertEqual(str(r), "[Rectangle] (12) 2/1 - 4/6")

    def test_str_default_xy(self):
        r = Rectangle(5, 5, 0, 0, 1)
        self.assertEqual(str(r), "[Rectangle] (1) 0/0 - 5/5")


class TestRectangle_update(unittest.TestCase):
    """Unit tests for testing the update method of Rectangle."""

    def test_update_args_all(self):
        r = Rectangle(10, 10, 10, 10)
        r.update(89, 2, 3, 4, 5)
        self.assertEqual(str(r), "[Rectangle] (89) 4/5 - 2/3")

    def test_update_args_partial(self):
        r = Rectangle(10, 10, 10, 10)
        r.update(89)
        self.assertEqual(r.id, 89)
        self.assertEqual((r.width, r.height, r.x, r.y), (10, 10, 10, 10))

    def test_update_args_none(self):
        r = Rectangle(10, 10, 10, 10, 1)
        r.update()
        self.assertEqual(str(r), "[Rectangle] (1) 10/10 - 10/10")

    def test_update_kwargs(self):
        r = Rectangle(10, 10, 10, 10)
        r.update(y=1, width=2, x=3, id=89)
        self.assertEqual(str(r), "[Rectangle] (89) 3/1 - 2/10")

    def test_update_kwargs_skipped_if_args(self):
        r = Rectangle(10, 10, 10, 10, 1)
        r.update(50, height=99)
        self.assertEqual(r.id, 50)
        self.assertEqual(r.height, 10)


class TestRectangle_to_dictionary(unittest.TestCase):
    """Unit tests for testing to_dictionary method of Rectangle."""

    def test_to_dictionary_keys_values(self):
        r = Rectangle(10, 2, 1, 9, 1)
        expected = {"id": 1, "width": 10, "height": 2, "x": 1, "y": 9}
        self.assertEqual(r.to_dictionary(), expected)

    def test_to_dictionary_type(self):
        self.assertIsInstance(Rectangle(1, 1).to_dictionary(), dict)

    def test_to_dictionary_roundtrip(self):
        r1 = Rectangle(10, 2, 1, 9)
        r2 = Rectangle(1, 1)
        r2.update(**r1.to_dictionary())
        self.assertEqual(str(r1), str(r2))


if __name__ == "__main__":
    unittest.main()
